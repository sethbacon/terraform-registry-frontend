# Local dev TLS certs generated by deployments/keycloak/generate-dev-certs.ps1
deployments/certs/

# tsc build artefacts. tsconfig.node.json is "composite", which forces emit, and
# the build script is `tsc && vite build` -- so these land beside the source.
# vite.config.js is the dangerous one: Vite resolves it BEFORE vite.config.ts,
# so a committed copy silently becomes the real build config. tsconfig.node.json
# now sets noEmit; these stay ignored so a stale local artefact from an older
# checkout cannot shadow the source again or be recommitted.
frontend/vite.config.js
frontend/vite.config.d.ts
frontend/*.tsbuildinfo

# Node (CI tooling only, under .github/; the lockfile itself is tracked)
node_modules/
