# ECS-specific nginx configuration — processed via envsubst at container startup.
#
# Key differences from nginx.conf (local Docker Compose):
#
#   1. Plain HTTP only (port 80). TLS is terminated at the ALB; the container
#      never sees HTTPS traffic.
#
#   2. /api/ proxies to ${BACKEND_URL} as a FALLBACK router. On ECS the ALB's
#      higher-priority listener rules send /api/* straight to the backend target
#      group, so this block is normally never hit there; on platforms without a
#      path router in front (Cloud Run, Azure Container Apps) nginx IS the
#      router and this block is what makes the SPA's API calls work.
#
#   3. BACKEND_URL is substituted by nginx's 20-envsubst-on-templates.sh at
#      startup. Set it to the ALB's public URL (e.g. https://registry.example.com)
#      in the ECS task definition environment. The proxy blocks below forward
#      Terraform protocol paths that arrive at the frontend target group via the
#      ALB default rule; in practice those paths should be intercepted by the
#      higher-priority ALB listener rules and never reach nginx.

# Derive the per-request CSP nonce ONCE. A map variable is evaluated lazily and
# cached for the whole request — surviving the internal redirect to /index.html —
# so the CSP header and the sub_filter body rewrite see the SAME value. A plain
# `set $csp_nonce $request_id` re-runs after that redirect and yields a SECOND,
# different id, so the header nonce and the <meta>/emotion nonce disagree and the
# browser blocks every injected style. See frontend/nginx.conf for the same fix.
map $request_id $csp_nonce {
    default $request_id;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # ${BACKEND_URL} is https on Cloud Run / ACA — send SNI on proxied TLS.
    proxy_ssl_server_name on;

    # Security headers
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # connect-src 'self' also constrains VITE_SENTRY_DSN / VITE_ERROR_REPORTING_DSN /
    # VITE_PERFORMANCE_DSN (services/errorReporting.ts, performanceReporting.ts): a
    # genuinely cross-origin DSN (e.g. a Sentry SaaS *.ingest.sentry.io endpoint) will
    # have its fetch/sendBeacon calls silently blocked by the browser. Route such DSNs
    # through this reverse proxy instead, or add their origin here (see ARCHITECTURE.md).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'nonce-$csp_nonce'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none';" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;

    # Inject CSP nonce into index.html. once off = replace EVERY __CSP_NONCE__
    # so the <meta> is covered even if another occurrence precedes it in the document.
    sub_filter_once off;
    sub_filter '__CSP_NONCE__' '$csp_nonce';

    # Upload size limit (matches backend: 100MB modules, 500MB providers)
    client_max_body_size 500m;

    # SPA fallback - serve index.html for all non-file requests
    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /swagger.json {
        proxy_pass ${BACKEND_URL}/swagger.json;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /v1/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /.well-known/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /webhooks/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /terraform/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # nginx add_header is REPLACE-BY-LEVEL, not additive: "these directives are
        # inherited from the previous configuration level if and only if there are
        # no add_header directives defined on the current level". The
        # Content-Type line below is one, so without re-declaring them here this
        # location serves with NONE of the six server-level security headers.
        #
        # This is the one same-origin path carrying content the operator does not
        # author -- /terraform/ is the network-mirror protocol, proxying provider
        # metadata from third-party upstream registries -- so it is the worst
        # place in the config to lose nosniff and the CSP.
        #
        # Duplication here is deliberate and guarded: nginxHeaderInheritance.test.ts
        # fails if any location that defines add_header omits one of these.
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'nonce-$csp_nonce'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none';" always;
        add_header Content-Type "application/json" always;
    }

    location /health {
        proxy_pass ${BACKEND_URL}/health;
    }

    location /ready {
        proxy_pass ${BACKEND_URL}/ready;
    }
}
